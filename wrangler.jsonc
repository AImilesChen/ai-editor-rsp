{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "ai-editor-rsp",
	"compatibility_date": "2026-06-07",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "BILLING_KV",
			"id": "9c19c01ef21541ae9b08f621f9af9001"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ai_editor_rsp",
			"database_id": "52f89a34-11a4-4ecf-b0fc-2ad72a914f10"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_ASSETS",
			"bucket_name": "ai-editor-rsp-assets"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ai-editor-rsp"
		}
	],
	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}